# REQUIRED. Nominatim blocks generic User-Agents AND placeholder contacts:
# anything containing example.com is rejected with HTTP 403. Replace the URL
# below with your own contact (a real email or project URL you control) before
# using this beyond local development.
NOMINATIM_USER_AGENT="TripPlanner/0.1 (+http://localhost:3000)"

# Routing. "osrm" = FOSSGIS public instances (no key, real per-mode networks).
ROUTING_PROVIDER=osrm
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car

# Optional fallback: set ROUTING_PROVIDER=ors and supply a free key.
ORS_API_KEY=

OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
